{
  "name": "quangdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "emdash": {
    "label": "quangdk.com",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "typecheck": "astro check",
    "seed:local": "emdash seed seed/seed.json --database \"$(ls .wrangler/state/v3/d1/miniflare-D1DatabaseObject/*.sqlite | grep -v metadata)\""
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.3",
    "@astrojs/react": "^7.0.0",
    "@emdash-cms/cloudflare": "1.4.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.4",
    "emdash": "1.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260820.1",
    "wrangler": "^4.125.0"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.23.4"
  }
}
