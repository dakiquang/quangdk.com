{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "quangdk.com",
		"description": "Personal site of Quang Dang: work, writing and the decisions behind them",
		"author": "Quang Dang"
	},
	"settings": {
		"title": "Quang Dang",
		"tagline": "Product-minded tech lead. Simple is the hardest thing to build."
	},
	"collections": [
		{
			"slug": "posts",
			"label": "Writing",
			"labelSingular": "Article",
			"urlPattern": "/writing/{slug}",
			"supports": ["drafts", "revisions", "preview", "scheduling", "search", "seo"],
			"fields": [
				{ "slug": "title", "label": "Title", "type": "string", "required": true, "searchable": true },
				{
					"slug": "kind",
					"label": "Kind",
					"type": "select",
					"validation": { "options": ["Essay", "Production", "AI with guardrails", "Product", "Engineering"] }
				},
				{ "slug": "excerpt", "label": "Summary", "type": "text", "searchable": true },
				{ "slug": "featured_image", "label": "Featured image", "type": "image" },
				{ "slug": "content", "label": "Content", "type": "portableText", "searchable": true },
				{
					"slug": "lang",
					"label": "Language",
					"type": "select",
					"defaultValue": "en",
					"validation": { "options": ["en", "vi"] }
				},
				{ "slug": "translation_slug", "label": "Translation slug", "type": "string" }
			]
		},
		{
			"slug": "work",
			"label": "Work",
			"labelSingular": "Case study",
			"urlPattern": "/work/{slug}",
			"supports": ["drafts", "revisions", "preview", "search", "seo"],
			"fields": [
				{ "slug": "title", "label": "Title", "type": "string", "required": true, "searchable": true },
				{ "slug": "summary", "label": "Summary", "type": "text", "required": true, "searchable": true },
				{ "slug": "role", "label": "Role", "type": "string" },
				{ "slug": "years", "label": "Years", "type": "string" },
				{ "slug": "platforms", "label": "Platforms", "type": "string" },
				{ "slug": "stack", "label": "Stack", "type": "string" },
				{ "slug": "featured", "label": "Show on home", "type": "boolean" },
				{ "slug": "sort_order", "label": "Order", "type": "integer" },
				{ "slug": "featured_image", "label": "Featured image", "type": "image" },
				{
					"slug": "tradeoffs",
					"label": "Decisions and tradeoffs",
					"type": "repeater",
					"validation": {
						"subFields": [
							{ "slug": "decision", "label": "Decision", "type": "string", "required": true },
							{ "slug": "gave_up", "label": "What we gave up", "type": "string" },
							{ "slug": "why", "label": "Why it was worth it", "type": "string" }
						]
					}
				},
				{ "slug": "content", "label": "Content", "type": "portableText", "searchable": true }
			]
		},
		{
			"slug": "cuts",
			"label": "Before / After",
			"labelSingular": "Decision",
			"supports": ["drafts"],
			"fields": [
				{ "slug": "title", "label": "Internal name", "type": "string", "required": true },
				{ "slug": "before", "label": "Before", "type": "string", "required": true },
				{ "slug": "after", "label": "After", "type": "string", "required": true },
				{ "slug": "sort_order", "label": "Order", "type": "integer" }
			]
		}
	],
