---
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import type { WorkData } from "../../lib/content";
import { absolute } from "../../lib/site";

const { slug } = Astro.params;
if (!slug) return Astro.rewrite("/404");

const { entry, cacheHint } = await getEmDashEntry("work", slug);
if (!entry) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const data = entry.data as unknown as WorkData & { id: string; publishedAt: Date | null; updatedAt: Date };
const facts = [
	["Role", data.role],
	["Years", data.years],
	["Platforms", data.platforms],
	["Stack", data.stack],
].filter(([, value]) => value) as [string, string][];
const tradeoffs = data.tradeoffs ?? [];
---

<Base
	title={`${data.title} · Quang Dang`}
	pageTitle={data.title}
	description={data.summary}
	pageType="article"
	articleMeta={{
		publishedTime: data.publishedAt?.toISOString() ?? null,
		modifiedTime: data.updatedAt?.toISOString() ?? null,
		author: "Quang Dang",
	}}
	content={{ collection: "work", id: data.id, slug }}
	jsonLd={[
		{
			"@type": "BreadcrumbList",
			itemListElement: [
				{ "@type": "ListItem", position: 1, name: "Home", item: absolute("/") },
				{ "@type": "ListItem", position: 2, name: "Work", item: absolute("/work") },
				{ "@type": "ListItem", position: 3, name: data.title, item: absolute(`/work/${slug}`) },
			],
		},
	]}
>
	<article>
		<div class="hero cs-head frame">
			<div class="grid">
				<h1 class="display lines">
					<span class="line"><span data-line>{data.title}<span class="dot" aria-hidden="true"></span></span></span>
				</h1>
				<p class="lead" data-load style="--d:420ms">{data.summary}</p>
				{
					facts.length > 0 && (
						<dl class="cs-facts" data-load style="--d:500ms">
							{facts.map(([label, value]) => (
								<div>
									<dt>{label}</dt>
									<dd>{value}</dd>
								</div>
							))}
						</dl>
					)
				}
			</div>
		</div>

		<div class="section frame">
			<div class="grid">
				<div class="prose">
					{data.content && <PortableText value={data.content as never} />}

					{
						tradeoffs.length > 0 && (
							<>
								<h2 class="title" data-rise>
									Tradeoffs<span class="dot" aria-hidden="true" />
								</h2>
								<table class="tradeoff" data-rise>
									<thead>
										<tr>
											<th scope="col">Decision</th>
											<th scope="col">What we gave up</th>
											<th scope="col">Why it was worth it</th>
										</tr>
									</thead>
									<tbody>
										{tradeoffs.map((row) => (
											<tr>
												<td>{row.decision}</td>
												<td>{row.gave_up}</td>
												<td>{row.why}</td>
											</tr>
										))}
									</tbody>
								</table>
							</>
						)
					}

					<p class="byline small">Written by <a href="/about">Quang Dang</a>.</p>
					<p class="back"><a href="/work">Back to selected work</a></p>
				</div>
			</div>
		</div>
	</article>
</Base>
